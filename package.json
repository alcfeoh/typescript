{
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:app": "tsc -p tsconfig.build.json && vite build --config vite.app.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@types/jquery": "^3.5.16",
    "ag-grid": "^18.1.2",
    "ag-grid-community": "^32.3.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vitest": "^4.1.11"
  }
}
