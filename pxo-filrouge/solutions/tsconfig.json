{
  // Configuration du mode solution : `@/x` → solutions/x s'il existe, sinon src/x.
  // `npm run typecheck:solution` et `npm run test:solution` l'utilisent.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*", "../src/*"]
    }
  },
  // src/ n'est PAS listé : ses fichiers sont atteints par les imports, donc un fichier de départ
  // remplacé par une solution n'est jamais vérifié en mode solution. main.ts importe toutes les pages.
  "include": ["../src/main.ts", "../tests", "."],
  // Les versions de départ des tests ci-dessous sont remplacées par leur solution.
  "exclude": ["../tests/0-tests/typing-indicator.spec.ts", "../tests/e2e"]
}
